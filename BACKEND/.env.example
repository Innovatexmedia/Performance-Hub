# ==========================
# App Configuration
# ==========================
NODE_ENV=development
PORT=4001

# ==========================
# Database
# ==========================
MONGODB_URI=

# ==========================
# Authentication (JWT)
# ==========================
JWT_SECRET=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

JWT_ACCESS_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=

# ==========================
# Security
# ==========================
ENCRYPTION_KEY=
COOKIE_SECRET=

# ==========================
# Frontend
# ==========================
CLIENT_URL=http://localhost:5173

# ==========================
# Email (SMTP)
# ==========================
EMAIL_FROM=noreply@yourapp.com
EMAIL_USER=
EMAIL_PASSWORD=

# ==========================
# AI
# ==========================
GEMINI_API_KEY=
AI_PROVIDER=GEMINI

# ==========================
# Public Backend URL
# Use your ngrok URL for local testing
# Example: https://abc123.ngrok-free.app
# ==========================
API_BASE_URL=
SUPER_ADMIN_SECRET=

# worker queue 
REDIS_URL=redis://127.0.0.1:6379
CAMPAIGN_SEND_CONCURRENCY=5
CAMPAIGN_SEND_RATE_MAX=20
CAMPAIGN_SEND_RATE_DURATION_MS=1000

# cloudinary 
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret